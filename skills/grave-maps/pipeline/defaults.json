  "classes": [
    {"id": "ttak-dump", "name": "따닥덤프", "when": "base == 'dump' and r3 < 0.10 and ratio >= 0.03"},
    {"id": "dump",      "name": "덤프",     "when": "base == 'dump' and r3 < 0.10"},
    {"id": "ttak-tech", "name": "따닥테크", "when": "not (base == 'speedjack' and primary in ('jack', 'chordjack', 'tech')) and ratio >= 0.08 and main > 165"},
    {"id": "tech",      "name": "테크",     "when": "not (base == 'speedjack' and primary in ('jack', 'chordjack', 'tech'))"},
    {"id": "speedjack", "name": "스잭",     "when": "True"}
